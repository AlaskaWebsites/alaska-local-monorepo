{
  "name": "alaska-local",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "dev:web": "pnpm --filter @alaska/web dev",
    "dev:api": "pnpm --filter @alaska/api start:dev",
    "build": "turbo build",
    "build:contracts": "pnpm --filter @alaska/contracts build",
    "build:web": "pnpm --filter @alaska/web build",
    "build:api": "pnpm --filter @alaska/api build",
    "test": "turbo test",
    "test:web": "pnpm --filter @alaska/web test",
    "test:api": "pnpm --filter @alaska/api test",
    "test:contracts": "pnpm --filter @alaska/contracts test",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:seed": "pnpm --filter @alaska/api db:seed",
    "lint": "turbo lint",
    "clean": "turbo clean",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "turbo": "^2.4.0",
    "typescript": "^5.8.2"
  },
  "packageManager": "pnpm@10.5.2"
}