# ==============================================================================
# 🏔️ ALASKA LOCAL — FRONTEND ENVIRONMENT CONFIGURATION (apps/web/.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SERVIDOR HTTP (Nuxt 3 / Nitro)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# ------------------------------------------------------------------------------
# 2. INTEGRAÇÃO COM A API BACKEND (NestJS 11)
# URL base consumida via useRuntimeConfig().public.apiBaseUrl
# - Conectado diretamente à API em nuvem no Render (dispensa Docker e API local):
NUXT_PUBLIC_API_BASE_URL=https://alaska-local-api.onrender.com/api/v1
# - Para desenvolvimento com API local (se rodar pnpm dev:api na sua máquina):
# NUXT_PUBLIC_API_BASE_URL=http://localhost:3333/api/v1
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. DOMÍNIO BASE & MULTI-TENANCY (One Codebase, Infinite Domains)
# Utilizado para resolução de subdomínios (*.alaska.app) e domínios próprios
# - Desenvolvimento local: localhost:3000
# - Produção: alaska.app
# ------------------------------------------------------------------------------
NUXT_PUBLIC_APP_DOMAIN=localhost:3000
