{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@alaska/contracts": ["../../packages/contracts/src/index.ts"],
      "@alaska/contracts/*": ["../../packages/contracts/src/*"],
      "@core/*": ["src/core/*"],
      "@infra/*": ["src/infrastructure/*"],
      "@config/*": ["src/config/*"]
    }
  }
}
