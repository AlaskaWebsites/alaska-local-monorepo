# Configuração do Ambiente — Alaska Local Backend

# Ambiente de Execução
NODE_ENV=development
PORT=3333
CORS_ORIGINS=*

# Banco de Dados PostgreSQL (Local Docker ou Supabase)
DATABASE_URL=postgres://alaska:alaskapassword@localhost:5432/alaska_local

# Supabase em Nuvem (Opcional quando conectado em Produção)
SUPABASE_URL=
SUPABASE_KEY=

# Asaas API Key (Webhooks Pix D+0)
ASAAS_API_KEY=

# Redis (Filas BullMQ)
REDIS_URL=redis://localhost:6379
