{
  "name": "@alaska/contracts",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./tenant": {
      "types": "./dist/tenant/index.d.ts",
      "import": "./dist/tenant/index.mjs",
      "require": "./dist/tenant/index.js"
    },
    "./catalog": {
      "types": "./dist/catalog/index.d.ts",
      "import": "./dist/catalog/index.mjs",
      "require": "./dist/catalog/index.js"
    },
    "./order": {
      "types": "./dist/order/index.d.ts",
      "import": "./dist/order/index.mjs",
      "require": "./dist/order/index.js"
    },
    "./booking": {
      "types": "./dist/booking/index.d.ts",
      "import": "./dist/booking/index.mjs",
      "require": "./dist/booking/index.js"
    },
    "./pix": {
      "types": "./dist/pix/index.d.ts",
      "import": "./dist/pix/index.mjs",
      "require": "./dist/pix/index.js"
    },
    "./common": {
      "types": "./dist/common/index.d.ts",
      "import": "./dist/common/index.mjs",
      "require": "./dist/common/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "tsup": "^8.3.6",
    "typescript": "^5.8.2",
    "vitest": "^3.0.5"
  }
}
